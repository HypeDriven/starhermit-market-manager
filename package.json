{
  "name": "market-manager",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Market Manager — a bright isometric neighborhood market management game, on the StarHermit engine.",
  "scripts": {
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node tests/rules.test.mjs && node --test tests/i18n.test.mjs tests/store.test.mjs",
    "test:native": "node tests/native.mjs",
    "test:browser": "node tools/browser-play.mjs .",
    "package": "node tools/package-web.mjs",
    "css": "node tools/css.mjs",
    "plays": "node tools/gen-plays.mjs",
    "start": "node server.js 8080"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
